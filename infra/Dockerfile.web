# Frontend: statische build geserveerd door Caddy die ook /api doorstuurt.
FROM node:22 AS bouw
WORKDIR /bron
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY frontend/ .
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
RUN npm run build

# Marketingsite: scripts bundelen en minifiëren plus per route een index.html
# met eigen titel, beschrijving en canonical (audit 2026-08-11, G5 en H3).
FROM node:22 AS site
WORKDIR /site
COPY website_test/ .
COPY infra/bouw_website.mjs ./bouw_website.mjs
RUN npm install esbuild@0.24 --no-audit --no-fund && node bouw_website.mjs . \
    && rm -rf node_modules package.json package-lock.json bouw_website.mjs

FROM caddy:2
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=bouw /bron/dist /srv
# Statische marketingsite (testwebsite), gebouwd in de site fase hierboven.
COPY --from=site /site /srv-site
