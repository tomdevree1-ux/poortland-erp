# Backend: build en runtime op .NET 10, EU basisimages van Microsoft.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS bouw
WORKDIR /bron
COPY backend/Poortland.Api/ Poortland.Api/
RUN dotnet publish Poortland.Api/Poortland.Api.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=bouw /app .
ENV ASPNETCORE_URLS=http://0.0.0.0:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "Poortland.Api.dll"]
