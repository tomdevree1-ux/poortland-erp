{$DOMEIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:5000
	}
	handle /gezond {
		reverse_proxy api:5000
	}
	handle {
		root * /srv
		# Gehashte assets veranderen nooit: agressief cachen zodat een herlading niets opnieuw hoeft te halen.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Marketingsite (testwebsite) op een eigen hostname. Het formulier post same origin
# naar /api, dus geen CORS nodig; de rest is de statische React site.
{$SITE_DOMEIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:5000
	}
	# Foto's apart afhandelen: een ontbrekend mediabestand geeft nu een echte 404
	# in plaats van terug te vallen op index.html. Anders cachet de browser die
	# HTML een dag lang als 'foto' en blijft een later toegevoegde foto onzichtbaar.
	handle /media/* {
		root * /srv-site
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		root * /srv-site
		# De site heeft vaste bestandsnamen die per uitrol wijzigen. no-cache laat
		# de browser altijd revalideren (Etag), dus een nieuwe uitrol komt meteen
		# door zonder een oude versie te tonen.
		@site path / *.html *.js
		header @site Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
