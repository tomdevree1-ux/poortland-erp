{$DOMEIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:5000
	}
	handle /gezond {
		reverse_proxy api:5000
	}
	handle {
		root * /srv
		# Gehashte assets veranderen nooit: agressief cachen zodat een herlading niets opnieuw hoeft te halen.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Marketingsite (testwebsite) op een eigen hostname. Het formulier post same origin
# naar /api, dus geen CORS nodig; de rest is de statische React site.
{$SITE_DOMEIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:5000
	}
	handle {
		root * /srv-site
		# De site heeft vaste bestandsnamen die per uitrol wijzigen. Zonder
		# cacheheader gebruikt de browser heuristische caching en toont hij een
		# oude versie. no-cache laat de browser altijd revalideren (Etag), dus
		# een nieuwe uitrol komt meteen door; foto's mogen wel een dag cachen.
		@site path / *.html *.js
		header @site Cache-Control "no-cache"
		@media path /media/*
		header @media Cache-Control "public, max-age=86400"
		try_files {path} /index.html
		file_server
	}
}
