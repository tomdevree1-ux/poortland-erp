{$DOMEIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:5000
	}
	handle /gezond {
		reverse_proxy api:5000
	}
	handle {
		root * /srv
		# Gehashte assets veranderen nooit: agressief cachen zodat een herlading niets opnieuw hoeft te halen.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Marketingsite (testwebsite) op een eigen hostname. Het formulier post same origin
# naar /api, dus geen CORS nodig; de rest is de statische React site.
{$SITE_DOMEIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:5000
	}
	handle {
		root * /srv-site
		try_files {path} /index.html
		file_server
	}
}
