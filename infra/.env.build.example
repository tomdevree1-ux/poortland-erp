# Bouwinstellingen voor de website en het ERP. Kopieer naar .env.build en vul in.
# Het echte bestand staat bewust niet in de repository.

# Hostnaam van het ERP, bijvoorbeeld 167-233-223-227.nip.io
DOMEIN=
# Hostnaam van de marketingsite, bijvoorbeeld www.167-233-223-227.nip.io
SITE_DOMEIN=
# noindex, nofollow op een testserver; leeg laten in productie
ROBOTS_TAG=
# Supabase project url, bijvoorbeeld https://xxxx.supabase.co
VITE_SUPABASE_URL=
# Publieke anon sleutel van Supabase, mag in de browser staan
VITE_SUPABASE_ANON_KEY=
